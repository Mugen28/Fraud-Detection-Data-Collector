# ==============================================================================
# arkm crawler - Environment Configuration
# ==============================================================================

# Optional: Set DISPLAY for GUI forwarding in Docker (Linux hosts)
DISPLAY=:0

# Continuous scheduler daemon settings (hours)
INTERVAL_HOURS=24
JITTER_HOURS=2

# ==============================================================================
# Database Configuration (Local Backup + ClickHouse / LightHouse)
# ==============================================================================

# 1. Local Database (SQLite)
# ------------------------------------------------------------------------------
# Path to local SQLite database backup file (created automatically if missing)
LOCAL_DB_PATH=api_output/crawler_backup.db
ENABLE_LOCAL_DB=true

# 2. Remote ClickHouse / LightHouse Database
# ------------------------------------------------------------------------------
# You can configure either via individual fields or a full endpoint URL.
#
# Option A: Individual Host & Credentials
# Host / IP or domain name of ClickHouse instance
CLICKHOUSE_HOST=
# HTTP port: default is 8123 (unsecured HTTP) or 8443 (HTTPS / ClickHouse Cloud)
CLICKHOUSE_PORT=8123
# Username (default is 'default')
CLICKHOUSE_USER=default
# Password for the user
CLICKHOUSE_PASSWORD=
# Target database name (will be created automatically if missing)
CLICKHOUSE_DATABASE=default
# Enable TLS/SSL (true / false). Set true for ClickHouse Cloud or HTTPS.
CLICKHOUSE_SECURE=false

# Option B: Single Endpoint URL (Overrides individual fields if set)
# Examples:
#   http://default:@localhost:8123/default
#   https://user:password@your-instance.clickhouse.cloud:8443/default
# CLICKHOUSE_ENDPOINT=

# Set to true to fail pipeline if ClickHouse sync fails.
# When false (default), pipeline records local SQLite backup and logs a warning.
CLICKHOUSE_STRICT=false
